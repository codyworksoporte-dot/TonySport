Options -Indexes
SetEnvIf Authorization "(.*)" HTTP_AUTHORIZATION=$1
# Deny every file except the explicitly published API entry points. This also
# protects new internal PHP files, backups and documents accidentally placed here.
<FilesMatch "^(?!(?:auth|session|quote|generate|magic_eraser|finalize|order|tony-submit-order|wompi-crear-pago|wompi-retorno|wompi-verificar|wompi-webhook|mock-confirm)\.php$)">
    Require all denied
</FilesMatch>
