# Next.js build-time public URL only. No credential may have a NEXT_PUBLIC_ prefix.
NEXT_PUBLIC_TONY_API_BASE=

# PHP hosting environment: set through your host, never put this file in the web root.
TONY_ENV=production
TONY_API_MOCK=false
TONY_APP_SECRET=
TONY_FRONTEND_URL=https://codyworksoporte-dot.github.io/TonySport
TONY_ALLOWED_ORIGINS=https://tonysportselsalvador.com,https://www.tonysportselsalvador.com,https://codyworksoporte-dot.github.io,http://127.0.0.1:3000,http://localhost:3000
TONY_API_PUBLIC_URL=
TONY_PRIVATE_DIR=
# Deploy these same repository JSON files outside the public directory; no second price table.
TONY_PRICES_FILE=
TONY_CHECKOUT_FILE=

# Enable each service only after configuring and verifying it on the PHP host.
TONY_AI_ENABLED=false
GEMINI_API_KEY=
GEMINI_IMAGE_MODEL=gemini-3-pro-image
GEMINI_IMAGE_FALLBACK_MODEL=gemini-3.1-flash-image
TONY_PANEL_ENABLED=false
TONY_PANEL_URL=https://tonysportselsalvador.com/admin/api/receive-order.php
TONY_PANEL_TOKEN=
TONY_WOMPI_ENABLED=false
WOMPI_CLIENT_ID=
WOMPI_CLIENT_SECRET=
